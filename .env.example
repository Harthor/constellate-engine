# Required only for an explicitly confirmed paid run. Never commit a real key.
ANTHROPIC_API_KEY=

# Central model and conservative safety limits.
ANTHROPIC_MODEL=claude-fable-5
ANTHROPIC_MAX_OUTPUT_TOKENS=1024
ANTHROPIC_EFFORT=low
ANTHROPIC_MAX_BUDGET_USD=0
ANTHROPIC_MAX_CALLS=0
ANTHROPIC_CONCURRENCY=1

# Official Claude Fable 5 standard API pricing, per million tokens.
ANTHROPIC_INPUT_USD_PER_MILLION=10
ANTHROPIC_OUTPUT_USD_PER_MILLION=50

# Optional: improves Product Hunt ingestion. It is not used by Anthropic.
PRODUCTHUNT_TOKEN=
